; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mascot Horror 2026"
run/main_scene="uid://cdg6acv6uhj4o"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://byr7gicdkapgo"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
GlobalState="*uid://dnjev4kcq6fub"
GameManager="*uid://ony54a1c5afg"

[dialogic]

directories/dch_directory={
"Boy_char": "res://dialogic/characters/boy/Boy_char.dch",
"character test": "res://dialogic/characters/character test.dch",
"eggwatch_char": "res://dialogic/characters/eggwatch/eggwatch_char.dch",
"grandma_char": "res://dialogic/characters/grandma/grandma_char.dch",
"grandpa_char": "res://dialogic/characters/grandpa/grandpa_char.dch"
}
